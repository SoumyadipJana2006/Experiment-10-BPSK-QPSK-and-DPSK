# 6. MANDATORY QPSK MANUAL VALIDATION
# ==============================================================================

def manual_qpsk_validation():
    print("=" * 75)
    print("MANDATORY VALIDATION — GRAY-CODED QPSK MAPPING & DEMAPPING")
    print("=" * 75)

    pairs = [[0, 0], [0, 1], [1, 1], [1, 0]]
    print(f"{'Bit Pair':<12}{'Mapped Symbol (I + jQ)':<28}{'Magnitude':<14}{'Phase (deg)':<12}")
    print("-" * 75)

    for pair in pairs:
        bits_in = np.array(pair)
        sym = qpsk_mapper(bits_in)[0]
        mag = np.abs(sym)
        phase = np.rad2deg(np.angle(sym)) % 360
        print(f"{pair[0]}{pair[1]:<10}{sym.real:+.4f} {sym.imag:+.4f}j{'':<10}{mag:.4f}{'':<6}{phase:6.1f}°")

    print("\nEnd-to-End Detector Verification:")
    print("-" * 35)
    print(f"{'Input Bits':<15}{'Detected Bits':<15}{'Status'}")
    print("-" * 35)
    for pair in pairs:
        bits_in = np.array(pair)
        tx = qpsk_mapper(bits_in)
        rx = qpsk_demapper(tx)
        status = "PASSED" if np.array_equal(bits_in, rx) else "FAILED"
        print(f"{pair[0]}{pair[1]:<13}{rx[0]}{rx[1]:<13}{status}")
    print("=" * 75 + "\n")


