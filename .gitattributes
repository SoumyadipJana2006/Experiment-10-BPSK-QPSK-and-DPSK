# ==============================================================================
# 1. BPSK MODULATION AND DEMODULATION
# ==============================================================================

def bpsk_mapper(bits):
    """
    BPSK Mapper:
        bit 0 -> +1 + 0j (Phase 0°)
        bit 1 -> -1 + 0j (Phase 180°)
    Normalized average symbol energy Es = 1, Eb = 1.
    """
    bits = np.asarray(bits)
    symbols = 1 - 2 * bits
    return symbols.astype(complex)


def bpsk_demapper(received):
    """
    Coherent BPSK Demapper:
        Decision boundary at Re(r) = 0:
            Re(r) >= 0 -> bit 0
            Re(r) <  0 -> bit 1
    """
    return (received.real < 0).astype(int)


# ==============================================================================
# 2. GRAY-CODED QPSK MODULATION AND DEMODULATION
# ==============================================================================

def qpsk_mapper(bits):
    """
    Gray-coded QPSK Mapper:
        Bit Pair (b1, b2) -> In-Phase (I), Quadrature (Q) -> Phase
        ----------------------------------------------------------
             00           ->   +1/√2,   +1/√2            ->   45°
             01           ->   -1/√2,   +1/√2            ->  135°
             11           ->   -1/√2,   -1/√2            ->  225°
             10           ->   +1/√2,   -1/√2            ->  315°
    
    Energy normalization: |symbol| = 1, Es = 1, Eb = Es / 2 = 0.5.
    """
    bits = np.asarray(bits)
    if len(bits) % 2 != 0:
        bits = bits[:-1]

    bit_pairs = bits.reshape(-1, 2)
    b1 = bit_pairs[:, 0]
    b2 = bit_pairs[:, 1]

    # I mapping: 0 -> +1 for b2=0, -1 for b2=1
    # Q mapping: 0 -> +1 for b1=0, -1 for b1=1
    I = np.where(b2 == 0, 1.0, -1.0)
    Q = np.where(b1 == 0, 1.0, -1.0)

    symbols = (I + 1j * Q) / np.sqrt(2)
    return symbols


def qpsk_demapper(received):
    """
    Vectorized Coherent Gray-coded QPSK Demapper:
        I >= 0, Q >= 0 -> (0, 0)
        I <  0, Q >= 0 -> (0, 1)
        I <  0, Q <  0 -> (1, 1)
        I >= 0, Q <  0 -> (1, 0)
    """
    b1 = (received.imag < 0).astype(int)
    b2 = (received.real < 0).astype(int)
    return np.column_stack((b1, b2)).reshape(-1)


# ==============================================================================
# 3. DBPSK (DIFFERENTIAL BPSK) MODULATION AND DEMODULATION
# ==============================================================================

def dbpsk_mapper(bits):
    """
    Differential BPSK (DBPSK) Mapper:
        bit 0 -> No phase transition   (s[k] =  s[k-1])
        bit 1 -> 180° phase transition (s[k] = -s[k-1])
    A known reference symbol s[0] = +1 is transmitted first.
    """
    bits = np.asarray(bits)
    symbols = np.zeros(len(bits) + 1, dtype=complex)
    symbols[0] = 1.0 + 0j  # Reference symbol

    for k, bit in enumerate(bits):
        if bit == 0:
            symbols[k + 1] = symbols[k]
        else:
            symbols[k + 1] = -symbols[k]

    return symbols


def dbpsk_demapper(received):
    """
    Non-coherent Differential BPSK Demapper:
        Decision statistic: z[k] = r[k] * conj(r[k-1])
        Decision boundary:
            Re(z[k]) >= 0 -> bit 0
            Re(z[k]) <  0 -> bit 1
    """
    z = received[1:] * np.conj(received[:-1])
    detected_bits = (z.real < 0).astype(int)
    return detected_bits, z.real


# ==============================================================================
# 4. CHANNEL IMPAIRMENTS: PHASE OFFSET & AWGN
# ==============================================================================

def apply_phase_offset(symbols, phase_deg):
    """
    Introduces a carrier phase offset: r = s * exp(j * phi)
    """
    phi = np.deg2rad(phase_deg)
    return symbols * np.exp(1j * phi)


def add_awgn(symbols, ebn0_db, bits_per_symbol):
    """
    Adds complex Additive White Gaussian Noise (AWGN) given Eb/N0 (dB).
    Es = Mean symbol energy
    Eb = Es / bits_per_symbol
    N0 = Eb / (10^(Eb/N0_dB / 10))
    Noise variance per dimension sigma^2 = N0 / 2
    """
    Es = np.mean(np.abs(symbols) ** 2)
    Eb = Es / bits_per_symbol
    ebn0_lin = 10 ** (ebn0_db / 10)
    N0 = Eb / ebn0_lin
    noise_std = np.sqrt(N0 / 2)

    noise = noise_std * (
        np.random.randn(len(symbols)) + 1j * np.random.randn(len(symbols))
    )
    return symbols + noise


def calculate_ber(tx_bits, rx_bits):
    """
    Calculates the Bit Error Rate (BER) and total error count.
    """
    length = min(len(tx_bits), len(rx_bits))
    errors = np.sum(tx_bits[:length] != rx_bits[:length])
    return errors / length, errors


# ==============================================================================
# 5. THEORETICAL BER FORMULAS
# ==============================================================================

def theoretical_ber_bpsk(ebn0_db):
    """Theoretical BER for Coherent BPSK: Pb = Q(sqrt(2*Eb/N0)) = 0.5 * erfc(sqrt(Eb/N0))"""
    ebn0_lin = 10 ** (ebn0_db / 10)
    return 0.5 * erfc_vec(np.sqrt(ebn0_lin))


def theoretical_ber_qpsk(ebn0_db):
    """Theoretical BER for Coherent Gray-coded QPSK: Pb = Q(sqrt(2*Eb/N0)) = 0.5 * erfc(sqrt(Eb/N0))"""
    return theoretical_ber_bpsk(ebn0_db)


def theoretical_ber_dbpsk(ebn0_db):
    """Theoretical BER for Differential BPSK (DBPSK): Pb = 0.5 * exp(-Eb/N0)"""
    ebn0_lin = 10 ** (ebn0_db / 10)
    return 0.5 * np.exp(-ebn0_lin)


